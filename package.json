{
	"name": "nanobee",
	"private": true,
	"type": "module",
	"description": "NanoBee — a proactive AI assistant for everyday users",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "vite build && wrangler deploy --dry-run",
		"cf-typegen": "wrangler types",
		"deploy:prod": "vite build --mode prod && wrangler deploy --env prod",
		"deploy:dev": "vite build --mode dev && wrangler deploy --env dev",
		"deploy": "pnpm deploy:prod && pnpm deploy:dev",
		"db:migrate:local": "wrangler d1 migrations apply nanobee-db-dev --local",
		"db:migrate:dev": "wrangler d1 migrations apply nanobee-db-dev --remote --env dev",
		"db:migrate:prod": "wrangler d1 migrations apply nanobee-db --remote --env prod",
		"start:remote": "wrangler dev --remote",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@tanstack/react-query": "^5.90.16",
		"@tanstack/react-router": "^1.139.10",
		"@tanstack/react-start": "^1.139.10",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "4.11.3",
		"lucide-react": "^0.562.0",
		"nanoid": "^5.1.6",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.4",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.17.1",
		"@cloudflare/workers-types": "^4.20260611.1",
		"@eslint/js": "9.39.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/devtools-vite": "^0.4.1",
		"@types/node": "25.0.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.2",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.26",
		"globals": "17.0.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.51.0",
		"vite": "^7.3.0",
		"vite-tsconfig-paths": "^6.0.4",
		"vitest": "^4.0.16",
		"wrangler": "4.58.0"
	}
}
